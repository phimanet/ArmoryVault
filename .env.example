# ==============================================================================
# Armory Vault - Gmail SMTP Relay Configuration (Optional)
# ==============================================================================
# Copy this file to .env and configure if you wish to receive automated CCW renewal email alerts.

# Your Gmail address used to generate the Google App Password
GMAIL_USER=your_email@gmail.com

# Your 16-character Google App Password (from myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=your_16_char_app_password

# Recipient email address for renewal milestone notifications
RECIPIENT_EMAILS=your_email@gmail.com

# SMTP Server Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
